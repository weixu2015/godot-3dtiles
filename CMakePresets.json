{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Shared settings",
            "description": "Settings inherited by every preset. Uses single-config Ninja because godot-cpp v10 selects its bindings through the single-valued GODOTCPP_TARGET, and because templates/CMakeLists.txt requires CMAKE_BUILD_TYPE to be Debug or Release.",
            "generator": "Ninja",
            "hidden": true,
            "cacheVariables": {
                "GODOTCPP_API_VERSION": "4.7",
                "GODOTCPP_SYSTEM_HEADERS": "ON",
                "GODOTCPP_ENABLE_TESTING": "OFF",
                "GODOTCPP_WARNING_AS_ERROR": "OFF",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "windows-editor",
            "displayName": "Windows x64 - editor",
            "description": "For iterating inside the Godot editor. GODOTCPP_TARGET=editor is required because the camera manager reads editor viewport cameras through EditorInterface, which only exists with TOOLS_ENABLED.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/windows-editor",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_BUILD_TYPE": "Debug",
                "GODOTCPP_TARGET": "editor",
                "GODOTCPP_USE_HOT_RELOAD": "ON"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows x64 - release",
            "inherits": "windows-editor",
            "binaryDir": "${sourceDir}/build/windows-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GODOTCPP_TARGET": "template_release",
                "GODOTCPP_USE_HOT_RELOAD": "OFF"
            }
        },
        {
            "name": "linux-editor",
            "displayName": "Linux x64 - editor",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/linux-editor",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Debug",
                "GODOTCPP_TARGET": "editor",
                "GODOTCPP_USE_HOT_RELOAD": "ON"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux x64 - release",
            "inherits": "linux-editor",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GODOTCPP_TARGET": "template_release",
                "GODOTCPP_USE_HOT_RELOAD": "OFF"
            }
        },
        {
            "name": "macOS-editor",
            "displayName": "macOS universal - editor",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/macOS-editor",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "GODOTCPP_TARGET": "editor",
                "GODOTCPP_USE_HOT_RELOAD": "ON"
            }
        },
        {
            "name": "macOS-release",
            "displayName": "macOS universal - release",
            "inherits": "macOS-editor",
            "binaryDir": "${sourceDir}/build/macOS-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GODOTCPP_TARGET": "template_release",
                "GODOTCPP_USE_HOT_RELOAD": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-editor",
            "configurePreset": "windows-editor"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-editor",
            "configurePreset": "linux-editor"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "macOS-editor",
            "configurePreset": "macOS-editor"
        },
        {
            "name": "macOS-release",
            "configurePreset": "macOS-release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-editor",
            "configurePreset": "windows-editor",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-editor",
            "configurePreset": "linux-editor",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
