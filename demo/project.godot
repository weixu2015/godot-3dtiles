; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="godot-3dtiles Globe"
run/main_scene="res://globe.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1000
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/viewport_hud/plugin.cfg")

[rendering]

; Pin the renderer so running from the editor (F5) matches every probe and screenshot
; taken with `--rendering-driver opengl3`. The ground-atmosphere pass is authored in
; display space and encodes explicitly on the way out (see GlobeAtmosphereShading) -
; correct when ALBEDO hits the framebuffer directly under Compatibility, but under
; Forward+ that already-encoded value goes through the linear HDR buffer, tonemap and
; sRGB encode once more, which double-encodes: the globe reads brighter and whiter than
; the reference. If Forward+ support is ever wanted, that shader needs a renderer branch
; instead of a project toggle.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
