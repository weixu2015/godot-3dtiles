CMakeLists.txt.user

# build
build/*
build_release/*

# in-source cmake artefacts - these were committed by accident once already
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json

# editors
.vs/*

# extern
extern/*
!extern/CMakeLists.txt
!extern/third_party/
!extern/third_party/**

# Godot editor local state
.godot/

# WorkBuddy workspace data (project memory, project skills). Platform-managed, not
# source; keep it out of the repository so `git add -A` cannot sweep it in.
.workbuddy/

# generated godot import/uid sidecars at the project root of the demo. Godot 4.4+
# writes a .uid next to every script and resource; they are machine-local and
# regenerate on open, so none of them belong in the repository.
demo/addons/godot-3dtiles.gdextension.uid
demo/**/*.uid
demo/*.uid

# Screenshots written by the audit harnesses (demo/dataset_audit.gd,
# demo/implicit_audit.gd). They are local verification artefacts - useful to look at,
# not source. Regenerate with the scenes described in docs/ARCHITECTURE.md 5.4.
demo/audit_shots/
demo/http_shots/

lib/
