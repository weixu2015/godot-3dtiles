CMakeLists.txt.user

# build
build/*
build_release/*

# in-source cmake artefacts - these were committed by accident once already
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json

# editors
.vs/*

# extern
extern/*
!extern/CMakeLists.txt
!extern/third_party/
!extern/third_party/**

# Godot editor local state
.godot/

# WorkBuddy workspace data (project memory, project skills). Platform-managed, not
# source; keep it out of the repository so `git add -A` cannot sweep it in.
.workbuddy/

# generated godot import/uid sidecars at the project root of the demo
demo/addons/godot-3dtiles.gdextension.uid

# Screenshots written by the audit harnesses (demo/dataset_audit.gd,
# demo/implicit_audit.gd, demo/http_audit.gd). They are local verification artefacts -
# useful to look at, not source. Kept here so switching between main and this branch does
# not leave the other branch's captures behind as untracked noise.
demo/audit_shots/
demo/http_shots/
demo/globe_shots/
# Globe capture output. GLOBE_OUT redirects the audit to a named file, and the bisecting
# loop that found the ellipsoid z-fight left a dozen of these behind. `globe_preview.png`
# is the exception worth keeping - it is the one image you actually compare against the
# reference, so it is tracked.
demo/_*.png
demo/_*.png.import

# Every temporary log this repo produces lives in log/ (scripts/build_tests.ps1,
# scripts/globe_capture.ps1 and scripts/globe_sweep.ps1 write there, and probes are run with
# their stdout redirected there). The dir is created on demand by the scripts, so it is the
# whole directory that is ignored - individual names would just invite the next script to
# write somewhere else and start the mess over.
log/

# Audit harness output. The globe audit writes one log per diagnostic run plus a numbered
# PNG, and a session that bisects a rendering bug produces dozens of both. None of it is
# source, and the sheer count drowns `git status` so badly that real changes get missed.
# Kept in addition to log/ because a stray `> something.log` is easy to type by accident.
*.log
*.log.err
*.log.txt
tests_summary.txt

# Per-run notes written while bisecting, e.g. sweep_run1.txt. They are working memory that
# only means anything inside the session that produced them, and a session leaves a dozen.
sweep_*.txt
cleanup_report.txt
gi_probe.txt
gsnap.txt
build_verify.txt

# Stray editor lock files next to the installed DLL. MSVC drops these when a build is
# killed mid-link; they are inert but confusing, because the name looks like a real build
# product and a stale copy can shadow the freshly installed one.
demo/addons/lib/**/~*

lib/

# Import sidecars for the six sky box faces. The faces themselves are tracked source; these are
# regenerated by the editor on first open and hold no setting worth a diff, so they only ever
# showed up as untracked noise in git status.
demo/skybox/*.jpg.import

# One-off QA harnesses. Each is a scene plus a script that instruments a single Globe3D
# behaviour, driven by hand rather than by CI (no workflow calls them) and hard-coded to the
# author's machine - the probes point at E:/GISData/... - so they cannot run anywhere else.
# They also write PNGs into res://, which is what litters the worktree after a debugging
# session. None of them is repository content: use demo/globe.tscn for the real scene and
# tests/ for automated checks.
#
# The family is closed: every harness that answered its question has been retired into
# demo/_probe_archive/ (ignored, so it can never sweep into a commit), and what is left below
# are globs rather than a file-per-probe list - the next probe should not need a new
# .gitignore entry. When re-verifying one of their claims, note that origin_shift_probe is the
# rebase-cost / jitter check, precision_probe the float32 step at the working magnitude,
# dataset_switch_probe the per-stage stopwatch for a dataset switch, flight_probe the
# end-to-end switch and switch_probe the frame length of the jump. None survives in git history,
# so the archive is the only copy.
demo/*_probe.gd
demo/*_probe.gd.uid
demo/*_probe.tscn
demo/*_probe.png
demo/*_probe.png.import
demo/_probe_archive/
demo/mip_verify*.png
demo/mip_verify*.png.import
