CMakeLists.txt.user

# build
build/*
build_release/*

# in-source cmake artefacts - these were committed by accident once already
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json

# editors
.vs/*

# extern
extern/*
!extern/CMakeLists.txt
!extern/third_party/
!extern/third_party/**

# Godot editor local state
.godot/

# WorkBuddy workspace data (project memory, project skills). Platform-managed, not
# source; keep it out of the repository so `git add -A` cannot sweep it in.
.workbuddy/

# generated godot import/uid sidecars at the project root of the demo
demo/addons/godot-3dtiles.gdextension.uid

# Screenshots written by the audit harnesses (demo/dataset_audit.gd,
# demo/implicit_audit.gd, demo/http_audit.gd). They are local verification artefacts -
# useful to look at, not source. Kept here so switching between main and this branch does
# not leave the other branch's captures behind as untracked noise.
demo/audit_shots/
demo/http_shots/
demo/globe_shots/
# Globe capture output. GLOBE_OUT redirects the audit to a named file, and the bisecting
# loop that found the ellipsoid z-fight left a dozen of these behind. `globe_preview.png`
# is the exception worth keeping - it is the one image you actually compare against the
# reference, so it is tracked.
demo/_*.png
demo/_*.png.import

# Audit harness output. The globe audit writes one log per diagnostic run plus a numbered
# PNG, and a session that bisects a rendering bug produces dozens of both. None of it is
# source, and the sheer count drowns `git status` so badly that real changes get missed.
*.log
*.log.err
*.log.txt
tests_summary.txt

# Per-run notes written while bisecting, e.g. sweep_run1.txt. They are working memory that
# only means anything inside the session that produced them, and a session leaves a dozen.
sweep_*.txt
cleanup_report.txt
gi_probe.txt
gsnap.txt
build_verify.txt

# Stray editor lock files next to the installed DLL. MSVC drops these when a build is
# killed mid-link; they are inert but confusing, because the name looks like a real build
# product and a stale copy can shadow the freshly installed one.
demo/addons/lib/**/~*

lib/

# One-off QA harnesses. Each of these is a scene plus a script that instruments a single
# Globe3D behaviour, is driven by hand rather than by CI (there is no workflow that calls
# them), and hard-codes the author's machine - the probes below point at E:/GISData/... - so
# they cannot run anywhere else. They also write PNGs into res://, which is what litters the
# worktree after a debugging session. They are not repository content: use demo/globe.tscn
# for the real scene and tests/ for automated checks.
#
# Only the three that gate current work are still around: origin_shift_probe answers "is
# the jitter gone, and what does a rebase cost", precision_probe measures the float32 step
# at the working magnitude, dataset_switch_probe replays the demo's dataset switch with a
# stopwatch on every stage (rebase cost, reload cost, worst frame). All are the only way to
# re-verify their feature after a change, so deleting them would leave the claim untestable.
# The rest of this family (http_audit / globe_fly_audit / implicit_audit / camera_p3 /
# capture_globe / seam_probe / switch_probe) has been removed - each had answered its
# question and none was referenced by scripts/ or the docs.
demo/origin_shift_probe.gd
demo/origin_shift_probe.gd.uid
demo/precision_probe.gd
demo/precision_probe.gd.uid
demo/dataset_switch_probe.gd
demo/dataset_switch_probe.gd.uid
demo/atmo_workpoint_probe.gd
demo/atmo_workpoint_probe.gd.uid

# globe_capture is the one harness that survives as tracked content: scripts/globe_capture.ps1
# runs res://globe_capture.tscn by path, and its env-gated negative controls (GLOBE_ZERO_TILE_CENTER,
# GLOBE_NO_ORIGIN_SHIFT) are what proved the RTC shading fix. Its uid sidecar is
# editor-generated noise rather than a matching pair - the editor regenerates it on next open.
demo/*_audit.gd.uid
